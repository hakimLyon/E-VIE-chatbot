# --- Django ---
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=evie.aimssnportal.org,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://evie.aimssnportal.org
# Where SQLite, uploads and the Chroma index live (mounted volume in Docker)
DATA_DIR=/data

# --- Cloudflare Workers AI (OpenAI-compatible endpoint) ---
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AI_CHAT_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
CF_AI_EMBED_MODEL=@cf/baai/bge-m3

# --- RAG tuning (optional) ---
RAG_TOP_K=5
RAG_HISTORY_TURNS=6
